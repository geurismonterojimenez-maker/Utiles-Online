  "version": "1.0.0",
  "description": "Herramientas educativas gratuitas para estudiantes y docentes",
  "type": "module",
  "main": "server.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server.cjs",
