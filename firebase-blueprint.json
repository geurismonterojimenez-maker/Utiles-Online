{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and subscription metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "Verified Google email"
        },
        "displayName": {
          "type": "string",
          "description": "Full name"
        },
        "photoURL": {
          "type": "string",
          "description": "Google avatar URL"
        },
        "role": {
          "type": "string",
          "enum": ["FREE", "PRO"],
          "description": "Standard user tier"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp ISO"
        }
      },
      "required": ["uid", "email", "role"]
    },
    "PaymentMethod": {
      "title": "PaymentMethod",
      "description": "Linked credit card or mock payment method",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID of payment method"
        },
        "cardholderName": {
          "type": "string",
          "description": "Full cardholder name"
        },
        "brand": {
          "type": "string",
          "description": "Card brand: visa, mastercard, amex"
        },
        "last4": {
          "type": "string",
          "description": "Last 4 digits of the card"
        },
        "expiry": {
          "type": "string",
          "description": "MM/YY expiry format"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp ISO"
        }
      },
      "required": ["id", "cardholderName", "brand", "last4", "expiry"]
    },
    "UsageLog": {
      "title": "UsageLog",
      "description": "Audit trail log of tool/calculator usage to monitor activity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "calculatorId": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "uid", "email", "calculatorId", "description", "timestamp"]
    },
    "SubscriptionLog": {
      "title": "SubscriptionLog",
      "description": "Subscription mutation details for financial audits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "previousTier": { "type": "string" },
        "newTier": { "type": "string" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "uid", "email", "previousTier", "newTier", "reason", "timestamp"]
    },
    "CommunityList": {
      "title": "CommunityList",
      "description": "School supply lists contributed by parents and community members",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique list identifier" },
        "schoolName": { "type": "string", "description": "Name of the school" },
        "grade": { "type": "string", "description": "Grade level" },
        "academicYear": { "type": "string", "description": "Academic year" },
        "createdBy": { "type": "string", "description": "Name of parent/contributor" },
        "creatorUid": { "type": "string", "description": "Self-identified contributor uid" },
        "items": { "type": "array", "description": "List of supplies in this school grade list" },
        "createdAt": { "type": "string", "description": "ISO creation date timestamp" },
        "likes": { "type": "integer", "description": "Upvote counter" }
      },
      "required": ["id", "schoolName", "grade", "academicYear", "createdBy", "items", "createdAt"]
    },
    "PriceAlert": {
      "title": "PriceAlert",
      "description": "User subscribed notifications when school items drop in price",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "targetPrice": { "type": "integer" },
        "currentPriceAtCreate": { "type": "integer" },
        "status": { "type": "string", "enum": ["PENDING", "TRIGGERED"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "productId", "productName", "targetPrice", "status", "createdAt"]
    },
    "PopularProduct": {
      "title": "PopularProduct",
      "description": "Aggregated view hits for popular items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "hits": { "type": "integer" }
      },
      "required": ["id", "productId", "name", "hits"]
    },
    "SEOPage": {
      "title": "SEOPage",
      "description": "Optimized pre-rendered static content elements for search engine indexing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "metaDescription": { "type": "string" },
        "h1": { "type": "string" },
        "bodyMarkdown": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "slug", "title", "metaDescription", "h1", "bodyMarkdown"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Core profile document for each user"
    },
    "/users/{userId}/paymentMethods/{methodId}": {
      "schema": "PaymentMethod",
      "description": "Collection of payment options added by the user"
    },
    "/usageLogs/{logId}": {
      "schema": "UsageLog",
      "description": "Platform-wide calculator usage audit logs"
    },
    "/subscriptionLogs/{logId}": {
      "schema": "SubscriptionLog",
      "description": "Platform-wide subscription modifications history logs"
    },
    "/communityLists/{listId}": {
      "schema": "CommunityList",
      "description": "Global school lists added by contributing parents and community members"
    },
    "/priceAlerts/{alertId}": {
      "schema": "PriceAlert",
      "description": "User price threshold monitoring notifications list"
    },
    "/popularProducts/{prodId}": {
      "schema": "PopularProduct",
      "description": "View counts tracking dashboard analytics"
    },
    "/seoPages/{pageId}": {
      "schema": "SEOPage",
      "description": "Indexable descriptive routing configurations"
    }
  }
}
